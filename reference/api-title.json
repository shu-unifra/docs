{
  "openapi": "3.1.0",
  "info": {
    "title": "prefixItems Example API",
    "version": "1.0.0"
  },
  "paths": {
    "/products": {
      "post": {
        "operationId": "createProductRecord",
        "summary": "Create a new product record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product record created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductRecord": {
        "type": [
          "integer",
          "string",
          "number",
          "boolean",
          "object"
        ],
        "default": [
          1,
          "top default",
          0.0,
          true,
          {
            "a": "b"
          }
        ],
        "description": "一个产品记录元组：[ID, Name, Price, InStock]",
        "minItems": 5,
        "maxItems": 5
      }
    }
  }
}