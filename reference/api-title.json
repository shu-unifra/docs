{
  "openapi": "3.1.0",
  "info": {
    "title": "prefixItems Example API",
    "version": "1.0.0"
  },
  "paths": {
    "/products": {
      "post": {
        "summary": "Create a new product record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product record created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductRecord": {
        "type": "array",
        "description": "一个产品记录元组：[ID, Name, Price, InStock]",
        "prefixItems": [
          {
            "type": "integer",
            "description": "产品 ID (整数)"
          },
          {
            "type": "string",
            "description": "产品名称 (字符串)"
          },
          {
            "type": "number",
            "format": "float",
            "description": "价格 (数字)"
          },
          {
            "type": "boolean",
            "description": "是否有库存 (布尔值)"
          }
        ],
        "minItems": 4,
        "maxItems": 4
      }
    }
  }
}
