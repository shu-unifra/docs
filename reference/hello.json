      "post": {
        "operationId": "a111",
        "summary": "Generic RPC method call",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "your-api-key",
            "in": "path",
            "required": true,
            "description": "Your personal API key for authentication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "54321"
                  },
                  "method": {
                    "type": "string",
                    "default": "eth_chainId"
                  },
                  "params": {
                    "type": "array",
                    "items": [
                      {
                        "type": "string",
                        "example": "latest"
                      },
                      {
                        "type": "boolean",
                        "example": true
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "default": ["latest", true]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful RPC response"
          },
          "204": {
            "description": "Request successful, no content to return."
          },
          "default": {
            "description": "unexpected error",
            "content": {
