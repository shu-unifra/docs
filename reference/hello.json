{
  "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": false
  },
  "x-readme-fauxas": true,
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Swagger Petstore",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://petstore.swagger.io/v1"
    }
  ],
  "paths": {
    "/{your-api-key}": {
      "post": {
        "summary": "Generic RPC method call",
        "operationId": "rpcMethodCall",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "your-api-key",
            "in": "path",
            "required": true,
            "description": "Your personal API key for authentication.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "default": "54321"
                  },
                  "method": {
                    "type": "string",
                    "default": "eth_chainId"
                  },
                  "params": {
                    "$ref": "#/components/schemas/Pet",
                   
                    "example":[
                        "latest",
                        true
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful RPC response"
          },
          "204": {
            "description": "Request successful, no content to return."
          },
          "default": {
            "description": "unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "description": "(\"latest\", \"earliest\", \"pending\", or a hex number)",
            "example": "latest",
            "default": "latest"
          },
          {
            "type": "boolean",
            "description": "",
            "example": true,
            "default": true
          }
        ],
        "minItems": 2,
        "maxItems": 2
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
